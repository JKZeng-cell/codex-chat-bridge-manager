# Feishu app credentials
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional security controls
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_COMMAND_PREFIX=/codex
FEISHU_ALLOW_PLAIN_TEXT_IN_P2P=true
FEISHU_ATTACHMENTS_ENABLED=true
FEISHU_PREFER_CLI=true
FEISHU_MAX_REPLY_CHARS=2000
FEISHU_REACTION_ACK=OnIt
FEISHU_REACTION_SUCCESS=DONE
FEISHU_REACTION_FAILURE=ERROR
FEISHU_STREAMING_CARD_ENABLED=true
FEISHU_GRANT_REQUESTER_MANAGE_ACCESS=true
FEISHU_CARD_STREAM_UPDATE_MS=300
FEISHU_CARD_PATCH_UPDATE_MS=1500
FEISHU_CARD_CONTENT_MAX_CHARS=3200
FEISHU_CARD_REPLY_PREVIEW_CHARS=1000
FEISHU_CARD_COMMAND_MAX_ITEMS=6
FEISHU_PROGRESS_UPDATE_MS=1500
FEISHU_PROGRESS_MAX_LINES=8
FEISHU_PROGRESS_EDIT_LIMIT=15
FEISHU_PROGRESS_MESSAGE_MAX_CHARS=1800
FEISHU_PROGRESS_SUMMARY_MAX_CHARS=500
FEISHU_CLI_IDENTITY=bot
FEISHU_SESSION_THREADS_ENABLED=true
FEISHU_SESSION_THREAD_STORE_PATH=
FEISHU_REPLY_SKILL_ENABLED=true
FEISHU_REPLY_SKILL_PATH=
FEISHU_ATTACHMENT_DIR=
FEISHU_MAX_RECENT_ATTACHMENTS=5
FEISHU_RECENT_ATTACHMENT_TTL_MS=3600000

# Codex runner
CODEX_CLI_MODE=local
CODEX_CLI_BIN=
CODEX_CLI_PACKAGE=@openai/codex@latest
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_WORKDIR=
CODEX_ADD_DIRS=
CODEX_SKIP_GIT_REPO_CHECK=true
CODEX_EPHEMERAL=true
CODEX_TIMEOUT_MS=600000

# Extra Codex arguments as JSON array
# Example: ["--search"]
CODEX_EXTRA_ARGS_JSON=[]

# Runtime
MAX_CONCURRENT_JOBS=1
LOG_DIR=
STATE_DIR=

# Manager UI
MANAGER_HOST=127.0.0.1
MANAGER_PORT=3210
LARKSUITE_CLI_CONFIG_DIR=
