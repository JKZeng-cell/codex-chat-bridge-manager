{
  "name": "codex-chat-bridge-manager",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "JKZeng-cell",
  "description": "Third-party Codex chat bot connection manager for Feishu, WeCom, WeChat, and DingTalk.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "feishu": "node ./scripts/feishu-cli.js",
    "lark-cli": "node ./scripts/feishu-cli.js",
    "start": "node src/index.js",
    "bridge": "node src/bridge-single.js",
    "test": "node scripts/run-tests.js",
    "check:release": "node scripts/check-release.js",
    "desktop": "electron .",
    "desktop:prepare": "node scripts/prepare-desktop.js && electron scripts/create-desktop-icon.cjs",
    "desktop:dist": "npm run desktop:prepare && electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "@larksuite/cli": "^1.0.44",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@openai/codex": "^0.163.0",
    "@wecom/aibot-node-sdk": "^1.0.6",
    "dingtalk-stream": "^2.1.4",
    "dotenv": "^16.6.1",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "axios": "^1.20.0",
    "@electron/get": "^5.1.0"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.17.0"
  }
}
